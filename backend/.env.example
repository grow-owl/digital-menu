# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mdn2dez.mongodb.net/aura_restaurant?retryWrites=true&w=majority

# API Express Server Port
PORT=5000

# JWT Authentication Secret Key (use a long random string in production)
JWT_SECRET=aura-production-jwt-secret-key-change-me

# Environment Mode
NODE_ENV=production

# CORS Allowed Origins (comma-separated list of frontend URLs)
# Example: https://your-frontend.onrender.com,https://siligurichaiaddaa.com
ALLOWED_ORIGINS=https://your-frontend.onrender.com
